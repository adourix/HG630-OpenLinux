#!/bin/sh
BASE=${OPENLINUX_HOME:-}
[ -n "$BASE" ] || { case "$0" in /*/bin/openlinux-ssh-stop) BASE=${0%/bin/openlinux-ssh-stop} ;; esac; }
[ -n "$BASE" ] || { echo "ssh-stop: invoke by absolute package path" >&2; exit 2; }
[ "$#" -eq 0 ] || { echo "usage: $0" >&2; exit 2; }
PROC_ROOT=${OPENLINUX_PROC_ROOT:-/proc}
RUN=$BASE/var/run/openlinux-ssh
[ -d "$RUN" ] || { echo "OpenLinux SSH is stopped"; exit 0; }
[ ! -L "$RUN" ] && [ -r "$RUN/pid" ] || { echo "ssh-stop: state is invalid; no process signaled" >&2; exit 1; }
IFS= read -r pid < "$RUN/pid" || pid=
case "$pid" in ''|*[!0-9]*) echo "ssh-stop: invalid PID; no process signaled" >&2; exit 1 ;; esac
[ "$pid" -gt 1 ] 2>/dev/null || { echo "ssh-stop: invalid PID; no process signaled" >&2; exit 1; }
if [ ! -r "$PROC_ROOT/$pid/cmdline" ]; then
    rm -f "$RUN/pid" || exit 1
    rmdir "$RUN" 2>/dev/null || { echo "ssh-stop: stale state has unowned files; preserved" >&2; exit 1; }
    echo "OpenLinux SSH was not running (stale PID state removed)"
    exit 0
fi
cmd=$(cat "$PROC_ROOT/$pid/cmdline" 2>/dev/null)
case "$cmd" in *"/bin/sshd"*"-p"*) ;; *) echo "ssh-stop: PID does not match Dropbear; no process signaled" >&2; exit 1 ;; esac
kill -TERM "$pid" 2>/dev/null || { echo "ssh-stop: signal failed" >&2; exit 1; }
count=0
while [ "$count" -lt 10 ]; do
    [ -r "$PROC_ROOT/$pid/cmdline" ] || break
    remaining=$(cat "$PROC_ROOT/$pid/cmdline" 2>/dev/null)
    [ -n "$remaining" ] || break
    sleep 1
    count=$((count + 1))
done
[ ! -r "$PROC_ROOT/$pid/cmdline" ] || { echo "ssh-stop: daemon did not exit; state retained" >&2; exit 1; }
rm -f "$RUN/pid" || exit 1
rmdir "$RUN" 2>/dev/null || { echo "ssh-stop: unowned files remain in state directory" >&2; exit 1; }
echo "OpenLinux SSH stopped"
